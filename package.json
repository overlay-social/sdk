{
  "name": "@overlay-social/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for overlay.peck.to, the BSV / BRC-100 social overlay: typed read clients, Bitcoin Schema (B / MAP / AIP) builders, wallet connection and the Peck OS bridge client.",
  "license": "Open BSV License v5",
  "author": "Thomas Høiby",
  "homepage": "https://overlay.social",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overlay-social/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/overlay-social/sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./read": {
      "types": "./dist/read.d.ts",
      "import": "./dist/read.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./wallet": {
      "types": "./dist/wallet.d.ts",
      "import": "./dist/wallet.js"
    },
    "./sanitize": {
      "types": "./dist/sanitize.d.ts",
      "browser": "./dist/sanitize.web.js",
      "import": "./dist/sanitize.js"
    },
    "./sanitize/browser": {
      "types": "./dist/sanitize.d.ts",
      "import": "./dist/sanitize.browser.js",
      "default": "./dist/sanitize.browser.js"
    },
    "./peckos": {
      "types": "./dist/peckos.d.ts",
      "import": "./dist/peckos.js"
    },
    "./peckos/browser": {
      "types": "./dist/peckos.d.ts",
      "import": "./dist/peckos.browser.js",
      "default": "./dist/peckos.browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.browser.config.ts",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:exports": "node scripts/check-exports.mjs",
    "check:sanitize-browser": "node scripts/check-sanitize-browser.mjs",
    "sync:peck-view": "node scripts/sync-peck-view.mjs",
    "check:peck-view": "node scripts/sync-peck-view.mjs --check",
    "verify": "npm run lint && npm run typecheck && npm run check:peck-view && npm run test && npm run build && npm run check:exports",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "bsv",
    "overlay",
    "brc-100",
    "identity",
    "peck",
    "social",
    "metanet"
  ],
  "dependencies": {
    "@bsv/sdk": "^2.8.7",
    "dompurify": "^3.4.16",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.19.43",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "jsdom": ">=26"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    }
  }
}
