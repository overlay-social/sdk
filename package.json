{
  "name": "@overlay-social/sdk",
  "version": "0.3.0",
  "description": "Minimal read-only client for overlay.peck.to — identity resolution, profiles, feed and overlay state over the canonical BSV/BRC-100 social overlay.",
  "license": "Open BSV License v5",
  "author": "Thomas Høiby",
  "homepage": "https://overlay.social",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overlay-social/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/overlay-social/sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./read": {
      "types": "./dist/read.d.ts",
      "import": "./dist/read.js"
    },
    "./peckos": {
      "types": "./dist/peckos.d.ts",
      "import": "./dist/peckos.js"
    },
    "./peckos/browser": {
      "types": "./dist/peckos.d.ts",
      "import": "./dist/peckos.browser.js",
      "default": "./dist/peckos.browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.browser.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:exports": "node scripts/check-exports.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:exports",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "bsv",
    "overlay",
    "brc-100",
    "identity",
    "peck",
    "social",
    "metanet"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "tsup": "^8.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
